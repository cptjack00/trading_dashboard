# Copy to /opt/signal-deck/signal-deck.env (mode 600, owned by the signal-deck user)
# and fill in real values. Referenced by deploy/signal-deck.service.

# Shared login secret compared against the password submitted at /api/login.
SIGNAL_DECK_SECRET=change-me

# Tailscale interface address only — never 0.0.0.0. Get it with `tailscale ip -4`.
SIGNAL_DECK_HOST=100.x.y.z

SIGNAL_DECK_PORT=8000

# Optional: where the config-root scan list (New Run flow) is persisted.
# Defaults to config_roots.json in the backend's working directory.
# SIGNAL_DECK_CONFIG_ROOTS_FILE=/opt/signal-deck/backend/config_roots.json

# Optional: launch command for each project's two run types, plus the
# working directory to run it from. The config path is appended as the
# final argv token by the New Run flow, so a command should end just before
# where that path goes (some engines want a preceding "--config", some take
# it as a bare positional - see each engine's own CLI). Both of rustle's
# binaries require an explicit `--config` flag (neither accepts a bare
# positional path), and `cargo run ... --` is required before it so cargo
# itself doesn't try to parse `--config`. A project with no cwd, or a run
# type with no command, can't launch that run type from the dashboard (its
# own runs dir can still be scanned and shown in the run list).
# SIGNAL_DECK_RUSTLE_CWD=/opt/rustle
# SIGNAL_DECK_RUSTLE_BACKTEST_CMD=cargo run -p tt-replay --bin tt-replay --release -- --config
# SIGNAL_DECK_RUSTLE_LIVE_CMD=cargo run -p tt-live-runner --bin tt-live-runner --release -- --config
# SIGNAL_DECK_TICKTRADER_CWD=/opt/ticktrader-para
# SIGNAL_DECK_TICKTRADER_BACKTEST_CMD=python -m ticktrader backtest --config
# SIGNAL_DECK_TICKTRADER_LIVE_CMD=python -m ticktrader live --config

# rustle only: forces its trade log into this run's own directory (`--out`)
# instead of rustle's native `<mode>_<config-stem>/<date>/` path, which the
# dashboard has no way to resolve on its own - the launch date is picked
# internally by rustle, not passed in. Baked into app.py, not configurable.

# Optional: where the process-start registry (PID/start time, #9) and the
# durable stop-request log (#10) are persisted. Default to
# process_registry.json / stop_events.log in the backend's working directory.
# SIGNAL_DECK_PROCESS_REGISTRY_FILE=/opt/signal-deck/backend/process_registry.json
# SIGNAL_DECK_STOP_LOG_FILE=/opt/signal-deck/backend/stop_events.log
