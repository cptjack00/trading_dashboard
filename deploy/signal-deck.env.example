# Copy to /opt/signal-deck/signal-deck.env (mode 600, owned by the signal-deck user)
# and fill in real values. Referenced by deploy/signal-deck.service.

# Shared login secret compared against the password submitted at /api/login.
SIGNAL_DECK_SECRET=change-me

# Tailscale interface address only — never 0.0.0.0. Get it with `tailscale ip -4`.
SIGNAL_DECK_HOST=100.x.y.z

SIGNAL_DECK_PORT=8000
